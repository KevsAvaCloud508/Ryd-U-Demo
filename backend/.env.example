# Puerto en el que escucha la API
PORT=4000

NODE_ENV=development

# Cadena de conexión a PostgreSQL (usada por Prisma).
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://juanra@127.0.0.1:5432/Ryd-U"

# Secreto para firmar los JWT. Genera uno propio en cada entorno, nunca reutilices este valor.
JWT_SECRET="UdXwmhGvmXGJzjpgYqOldh0nftk97ungPHMVHSK/XXo="
JWT_EXPIRES_IN=7d

# Origen permitido para CORS (frontend)
CORS_ORIGIN="http://localhost:5173"

# URL publica del backend (para construir URLs de archivos subidos a disco local)
# PUBLIC_BASE_URL="http://localhost:4000"

# Cloudinary (OPCIONAL): si no se configura, los archivos se guardan en backend/uploads/
